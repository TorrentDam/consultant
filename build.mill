import mill.*, scalalib.*

object consultant extends ScalaModule {
  def scalaVersion = "3.9.0"

  def oxVersion     = "1.0.6"
  def tapirVersion  = "1.13.31"
  def chimpVersion  = "0.6.0"
  def sttpVersion   = "4.0.26"
  def circeVersion  = "0.14.16"
  def logbackVersion = "1.6.3"

  def mvnDeps = Seq(
    mvn"com.softwaremill.ox::core:$oxVersion",
    mvn"com.softwaremill.sttp.tapir::tapir-netty-server-sync:$tapirVersion",
    mvn"com.softwaremill.chimp::chimp-server:$chimpVersion",
    mvn"com.softwaremill.sttp.client4::core:$sttpVersion",
    mvn"io.circe::circe-core:$circeVersion",
    mvn"ch.qos.logback:logback-classic:$logbackVersion"
  )

  object test extends ScalaTests, TestModule.Munit {
    def munitVersion = "1.3.5"
    def mvnDeps = Seq(
      mvn"org.scalameta::munit::${munitVersion()}",
      mvn"com.softwaremill.chimp::chimp-client:$chimpVersion",
      mvn"com.softwaremill.sttp.client4::core:$sttpVersion"
    )
  }
}
