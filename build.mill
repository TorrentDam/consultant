//| mill-jvm-version: system

package build
import mill.*, scalalib.*, scalanativelib.*

object consultant extends ScalaModule {
  def scalaVersion = "3.8.4"

  object test extends ScalaTests, TestModule.Munit {
    def munitVersion = "1.3.5"
    def mvnDeps = Seq(
      mvn"org.scalameta::munit::${munitVersion()}"
    )
  }
}

object consultantNative extends ScalaNativeModule {
  def scalaVersion = "3.8.4"
  def scalaNativeVersion = "0.5.12"

  // Share sources and resources with the JVM module so the same code is built
  // for both targets.
  override def sources = Task { consultant.sources() }
  override def resources = Task { consultant.resources() }

  object test extends ScalaNativeTests, TestModule.Munit {
    def munitVersion = "1.3.5"
    override def mvnDeps = super.mvnDeps() ++ Seq(
      mvn"org.scalameta::munit::${munitVersion()}"
    )
    override def sources = Task { consultant.test.sources() }
    override def resources = Task { consultant.test.resources() }
  }
}
